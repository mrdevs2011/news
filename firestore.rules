rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // FMN — Firestore Security Rules
    //
    // Arxitektura: autentifikatsiya YO'Q (public news feed).
    // Himoya: maydon validatsiyasi, o'lcham limitlari, o'zgarmas
    // maydonlar, array o'sish cheklovi, noma'lum collection'lar
    // default deny.
    //
    // Collections:
    //   articles/{id}           — yangilik + tarjima + AI + muhokama
    //   articles/{id}/chats/{m} — legacy chat (hozir asosan aiMuhokama)
    //   days/{YYYY-MM-DD}       — TARIX kun markerlari
    //   sync/{date_mode_slot}   — GNews slot lock (04/12/20)
    // =========================================================

    function isStr(v, max) {
      return v is string && v.size() <= max;
    }

    function optStr(data, key, max) {
      return !(key in data) || isStr(data[key], max);
    }

    function optInt(data, key) {
      return !(key in data) || data[key] is int;
    }

    function optTs(data, key) {
      return !(key in data) || data[key] is timestamp;
    }

    function dateKeyOk(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function modeOk(v) {
      return v in ['global', 'local'];
    }

    function slotOk(v) {
      // Bo'sh string ham (eski yozuvlar / no-slot)
      return v in ['04', '12', '20'] || v == '';
    }

    // Article da ruxsat etilgan maydonlar (whitelist)
    function articleAllowedKeys(data) {
      return data.keys().hasOnly([
        'title', 'description', 'url', 'image', 'source', 'publishedAt',
        'mode', 'dateKey', 'slot', 'fetchedAt',
        'originalText', 'uzText', 'translatedTitle', 'translatedDesc',
        'aiSharh', 'explainResult', 'aiMuhokama'
      ]);
    }

    // Asosiy maydonlar tipi va o'lchami
    function articleFieldsOk(data) {
      return isStr(data.title, 500)
        && isStr(data.url, 2000)
        && data.url.size() > 0
        && modeOk(data.mode)
        && optStr(data, 'description', 5000)
        && optStr(data, 'image', 2000)
        && optStr(data, 'source', 200)
        && optStr(data, 'publishedAt', 80)
        && (
          !('dateKey' in data)
          || data.dateKey == ''
          || dateKeyOk(data.dateKey)
        )
        && (!('slot' in data) || slotOk(data.slot))
        && optTs(data, 'fetchedAt')
        && optStr(data, 'originalText', 8000)
        && optStr(data, 'uzText', 8000)
        && optStr(data, 'translatedTitle', 500)
        && optStr(data, 'translatedDesc', 5000)
        && optStr(data, 'aiSharh', 12000)
        && optStr(data, 'explainResult', 12000)
        && (!('aiMuhokama' in data) || muhokamaOk(data.aiMuhokama));
    }

    // Chat xabarlar ro'yxati: max 80, har element map + role/content limit
    function muhokamaOk(list) {
      return list is list
        && list.size() <= 80;
    }

    // Yangi qo'shilgan oxirgi xabar (arrayUnion) — role/content tekshiruvi
    function lastMuhokamaMsgOk(newList) {
      return newList is list
        && newList.size() > 0
        && newList[newList.size() - 1].keys().hasOnly(['role', 'content', 'createdAtMs'])
        && newList[newList.size() - 1].role in ['user', 'assistant']
        && isStr(newList[newList.size() - 1].content, 4000)
        && newList[newList.size() - 1].createdAtMs is int;
    }

    // O'zgarmas maydon: eski qiymat bor bo'lsa yangisi teng bo'lishi shart
    function immutableStr(newData, oldData, key) {
      return !(key in oldData)
        || !(key in newData)
        || newData[key] == oldData[key];
    }

    // ---- articles ----
    match /articles/{articleId} {
      // Public feed — o'qish ochiq
      allow read: if true;

      // Yangi yangilik (GNews upsert)
      allow create: if articleId is string
        && articleId.size() >= 8
        && articleId.size() <= 64
        && articleAllowedKeys(request.resource.data)
        && request.resource.data.keys().hasAll(['title', 'url', 'mode', 'fetchedAt'])
        && articleFieldsOk(request.resource.data)
        // Create paytida AI/chat spam qilmaslik — faqat feed maydonlari
        && !('aiSharh' in request.resource.data)
        && !('explainResult' in request.resource.data)
        && !('aiMuhokama' in request.resource.data);

      // Merge update: tarjima, AI sharh, chat, qayta upsert
      allow update: if articleAllowedKeys(request.resource.data)
        && articleFieldsOk(request.resource.data)
        // Identifikator maydonlar o'zgarmas
        && request.resource.data.url == resource.data.url
        && request.resource.data.mode == resource.data.mode
        // Bir marta yozilgan matnlar qayta yozilmasin (token/spam himoya)
        && immutableStr(request.resource.data, resource.data, 'originalText')
        && immutableStr(request.resource.data, resource.data, 'uzText')
        && immutableStr(request.resource.data, resource.data, 'translatedTitle')
        && immutableStr(request.resource.data, resource.data, 'translatedDesc')
        && immutableStr(request.resource.data, resource.data, 'aiSharh')
        && immutableStr(request.resource.data, resource.data, 'explainResult')
        // aiMuhokama: faqat o'sishi mumkin, bir yozuvda +0..+2 xabar, max 80
        && (
          !('aiMuhokama' in request.resource.data)
          || (
            !('aiMuhokama' in resource.data)
            && request.resource.data.aiMuhokama is list
            && request.resource.data.aiMuhokama.size() <= 2
            && lastMuhokamaMsgOk(request.resource.data.aiMuhokama)
          )
          || (
            resource.data.aiMuhokama is list
            && request.resource.data.aiMuhokama is list
            && request.resource.data.aiMuhokama.size() >= resource.data.aiMuhokama.size()
            && request.resource.data.aiMuhokama.size() <= resource.data.aiMuhokama.size() + 2
            && request.resource.data.aiMuhokama.size() <= 80
            && (
              request.resource.data.aiMuhokama.size() == resource.data.aiMuhokama.size()
              || lastMuhokamaMsgOk(request.resource.data.aiMuhokama)
            )
          )
        );

      // Arxiv — o'chirish taqiqlangan
      allow delete: if false;

      // Legacy subcollection (yangi kod asosan aiMuhokama ishlatadi)
      match /chats/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['role', 'content', 'createdAt', 'createdAtMs'])
          && request.resource.data.role in ['user', 'assistant']
          && isStr(request.resource.data.content, 4000)
          && (
            (
              'createdAt' in request.resource.data
              && request.resource.data.createdAt is timestamp
            )
            || (
              'createdAtMs' in request.resource.data
              && request.resource.data.createdAtMs is int
            )
          );
        allow update, delete: if false;
      }
    }

    // ---- days (TARIX marker) ----
    match /days/{date} {
      allow read: if true;
      allow create, update: if dateKeyOk(date)
        && request.resource.data.keys().hasOnly(['date'])
        && request.resource.data.date is string
        && request.resource.data.date == date;
      allow delete: if false;
    }

    // ---- sync (GNews slot lock: YYYY-MM-DD_mode_slot) ----
    match /sync/{syncId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
          'status', 'dateKey', 'mode', 'slot',
          'startedAtMs', 'startedAt', 'finishedAt',
          'count', 'error'
        ])
        && dateKeyOk(request.resource.data.dateKey)
        && modeOk(request.resource.data.mode)
        && request.resource.data.slot in ['04', '12', '20']
        && request.resource.data.status in ['pending', 'done', 'error']
        // Doc id spoofing: id = dateKey_mode_slot
        && syncId == request.resource.data.dateKey
            + '_' + request.resource.data.mode
            + '_' + request.resource.data.slot
        && optInt(request.resource.data, 'startedAtMs')
        && optTs(request.resource.data, 'startedAt')
        && optTs(request.resource.data, 'finishedAt')
        && (
          !('count' in request.resource.data)
          || (
            request.resource.data.count is int
            && request.resource.data.count >= 0
            && request.resource.data.count <= 500
          )
        )
        && optStr(request.resource.data, 'error', 500);

      allow delete: if false;
    }

    // ---- users (foydalanuvchi holati: tema, sozlamalar, read/later/opened) ----
    // Autentifikatsiya yo'q (public), shuning uchun uid faqat tasodifiy
    // client-generated identifikator — maxfiy ma'lumot emas, shaxsni
    // aniqlamaydi. Himoya: maydon whitelist + o'lcham/tur limitlari.

    function userAllowedKeys(data) {
      return data.keys().hasOnly([
        'theme', 'mode', 'translateOn', 'visibleCount', 'gnewsPage',
        'readIds', 'laterItems', 'openedItems', 'updatedAt'
      ]);
    }

    function themeOk(v) {
      return !(v is string) || v in ['light', 'dark'];
    }

    function idListOk(v, maxLen) {
      return v is list && v.size() <= maxLen;
    }

    function userFieldsOk(data) {
      return optStr(data, 'theme', 10) && themeOk(data['theme'])
        && (!('mode' in data) || modeOk(data['mode']))
        && (!('translateOn' in data) || data['translateOn'] is bool)
        && optInt(data, 'visibleCount')
        && optInt(data, 'gnewsPage')
        && (!('readIds' in data) || idListOk(data['readIds'], 500))
        && (!('laterItems' in data) || idListOk(data['laterItems'], 200))
        && (!('openedItems' in data) || idListOk(data['openedItems'], 200))
        && optTs(data, 'updatedAt');
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if uid is string
        && uid.size() >= 8
        && uid.size() <= 64
        && userAllowedKeys(request.resource.data)
        && userFieldsOk(request.resource.data);
      allow delete: if false;
    }

    // ---- Default: hamma narsa yopiq ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
